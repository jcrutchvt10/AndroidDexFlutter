* text=auto

# Windows scripts keep CRLF for direct shell execution.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source and docs stay normalized.
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.qml text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Bundled/runtime/vendor binaries should not produce noisy diffs.
*.apk binary
*.dll binary
*.exe binary
*.jar binary
*.pdb binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary

third_party/scrcpy/** linguist-vendored
third_party/scrcpy-fork/** linguist-vendored
docs/archive/** linguist-vendored
lib/**/*.g.dart linguist-generated
