<resources>
    <!-- Light theme kept for compatibility but RewriteDEX targets dark DeX aesthetic -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#1a73e8</item>
        <item name="android:colorPrimary">#1a73e8</item>
    </style>

    <!-- Modern dark DeX-inspired theme for Pixel desktop experience -->
    <style name="AppTheme.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#8ab4f8</item>
        <item name="android:colorPrimary">#8ab4f8</item>
        <item name="android:background">#121212</item>
        <item name="android:textColor">#e8eaed</item>
        <item name="android:windowBackground">#121212</item>
        <item name="android:statusBarColor">#0d1117</item>
        <item name="android:navigationBarColor">#0d1117</item>
        <!-- Better touch feedback and elevation hints -->
        <item name="android:colorControlHighlight">#33ffffff</item>
    </style>

    <!-- Section header style for settings and control UIs -->
    <style name="SectionHeader" parent="android:Widget.TextView">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#9aa0a6</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- Card-like container for widgets and settings rows -->
    <style name="DeXCard" parent="android:Widget">
        <item name="android:background">@drawable/dex_card_bg</item>
        <item name="android:elevation">2dp</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>
