# Local-only environment values. Copy to .env if needed; do not commit real secrets.

# Optional preferred ADB endpoint, for example 192.168.1.50:5555
REWRITEDEX_PREFERRED_ADB_ENDPOINT=

# Optional Android SDK override (defaults to %LOCALAPPDATA%\Android\Sdk)
ANDROID_HOME=

# Opik Cloud tracing for the host-side RewriteDEX agent bridge.
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
